{
  "name": "lifeflow-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LifeFlow AI - Claude destekli kişisel yaşam yönetimi ve planlama asistanı",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run typecheck && npm test && npm run build",
    "deploy": "gh-pages -d dist/client -m Yayin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "gh-pages": "^6.3.0"
  },
  "homepage": "https://rbiafdn.github.io/lifeflow-ai"
}
